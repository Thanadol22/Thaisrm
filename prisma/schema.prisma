generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id                   BigInt                @default(autoincrement())
  member_no            String                @id @unique @default(dbgenerated("lpad((nextval('member_no_seq'::regclass))::text, 4, '0'::text)")) @db.VarChar(20)
  fullNameTh           String                @map("full_name_th") @db.VarChar(255)
  fullNameEn           String?               @map("full_name_en") @db.VarChar(255)
  idLast4              String?               @map("id_last4") @db.VarChar(4)
  mobile               String?               @db.VarChar(30)
  email                String?               @unique @db.VarChar(255)
  lineId               String?               @map("line_id") @db.VarChar(100)
  address              String?
  workplace            String?               @db.VarChar(255)
  work_phone           String?               @db.VarChar(50)
  work_start_date      DateTime?             @db.Date
  position             String?               @db.VarChar(150)
  job_category         String?               @db.VarChar(50)
  job_category_other   String?               @db.VarChar(255)
  scientist_license_no String?               @db.VarChar(50)
  username             String?               @db.VarChar(100)
  password_hash        String?               @db.VarChar(255)
  referees             String?
  photo_url            String?               @db.VarChar(500)
  id_card_doc          String?               @db.VarChar(500)
  degree_cert_doc      String?               @db.VarChar(500)
  work_cert_doc        String?               @db.VarChar(500)
  membership_status    String?               @default("Active") @db.VarChar(50)
  membership_type      String?               @default("Regular") @db.VarChar(50)
  applied_at           DateTime?             @default(now()) @db.Timestamptz(6)
  expire_date          DateTime?             @db.Date
  special_expire_date  DateTime?             @db.Date
  qr_code_data         Json?
  qr_code_image_url    String?                  @db.VarChar(500)
  meeting_attendances  meeting_attendances[]
  member_educations    member_educations[]
  payment_slips        payment_slips[]
  daily_checkins       meeting_daily_checkins[]
  coupon_usages        coupon_usages[]

  @@index([email], map: "idx_members_email")
  @@index([fullNameTh], map: "idx_members_name_th")
  @@map("members")
}

model meeting_attendances {
  attendance_id       BigInt                   @id @default(autoincrement())
  meeting_id          String                   @db.VarChar(50)
  member_no           String?                  @db.VarChar(20)
  attendee_name       String?                  @db.VarChar(255)
  attendee_email      String?                  @db.VarChar(255)
  attendee_phone      String?                  @db.VarChar(50)
  workplace           String?                  @db.VarChar(255)
  attendance_status   String                   @default("Registered") @db.VarChar(50)
  checkin_time        DateTime?                @db.Timestamptz(6)
  meetings            meetings                 @relation(fields: [meeting_id], references: [meeting_id], onUpdate: NoAction)
  members             Member?                  @relation(fields: [member_no], references: [member_no], onDelete: Cascade, onUpdate: NoAction)
  daily_checkins      meeting_daily_checkins[]

  @@unique([meeting_id, member_no], map: "uq_member_meeting")
  @@index([meeting_id], map: "idx_attendance_meeting")
  @@index([member_no], map: "idx_attendance_member")
}

model meetings {
  meeting_id           String                   @id @db.VarChar(50)
  meeting_name         String                   @db.VarChar(255)
  meeting_date         DateTime                 @db.Date
  start_date           DateTime?                @db.Date
  end_date             DateTime?                @db.Date
  counts_toward_active Boolean                  @default(true)
  meeting_time         String?                  @db.VarChar(100)
  location             String?                  @db.VarChar(500)
  meeting_type         String?                  @default("onsite") @db.VarChar(20)
  staff_code           String?                  @db.VarChar(10)
  description          String?
  base_price           Int?                     @default(0)
  change_format_fee    Int?                     @default(0)
  change_format_deadline DateTime?              @db.Date
  change_format_policy String?
  pricing_tiers        Json?
  activities           Json?
  max_seats            Int?                     @default(0)
  status               String?                  @default("upcoming") @db.VarChar(20)
  meeting_attendances  meeting_attendances[]
  payment_slips        payment_slips[]
  daily_checkins       meeting_daily_checkins[]
  coupons              coupons[]
  coupon_usages        coupon_usages[]
}

model meeting_daily_checkins {
  id                  BigInt               @id @default(autoincrement())
  meeting_id          String               @db.VarChar(50)
  attendance_id       BigInt?
  member_no           String?              @db.VarChar(20)
  ticket_code         String               @db.VarChar(50)
  checkin_date        DateTime             @db.Date
  program_name        String?              @db.VarChar(255)
  daily_qr_token      String?              @unique @db.VarChar(100)
  checkin_status      String               @default("pending") @db.VarChar(50)
  checkin_time        DateTime?            @db.Timestamptz(6)
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime             @default(now()) @updatedAt @db.Timestamptz(6)

  meetings            meetings             @relation(fields: [meeting_id], references: [meeting_id], onDelete: Cascade, onUpdate: NoAction)
  meeting_attendances meeting_attendances? @relation(fields: [attendance_id], references: [attendance_id], onDelete: Cascade, onUpdate: NoAction)
  members             Member?              @relation(fields: [member_no], references: [member_no], onDelete: Cascade, onUpdate: NoAction)

  @@unique([meeting_id, ticket_code, checkin_date], map: "uq_meeting_ticket_daily")
  @@index([meeting_id], map: "idx_daily_checkin_meeting")
  @@index([daily_qr_token], map: "idx_daily_checkin_token")
  @@index([checkin_date], map: "idx_daily_checkin_date")
  @@map("meeting_daily_checkins")
}

model member_educations {
  edu_id          BigInt  @id @default(autoincrement())
  member_no       String  @db.VarChar(20)
  degree          String  @db.VarChar(150)
  institution     String  @db.VarChar(255)
  graduation_year String? @db.VarChar(10)
  members         Member  @relation(fields: [member_no], references: [member_no], onDelete: Cascade, onUpdate: NoAction)
}

model payment_slips {
  id                  BigInt    @id @default(autoincrement())
  slip_id             String    @unique @default(uuid()) @db.VarChar(50)
  meeting_id          String    @db.VarChar(50)
  member_no           String?   @db.VarChar(20)
  guest_name          String?   @db.VarChar(255)
  guest_email         String?   @db.VarChar(255)
  guest_phone         String?   @db.VarChar(50)
  guest_workplace     String?   @db.VarChar(255)
  is_member           Boolean   @default(false)
  ticket_code         String?   @db.VarChar(50)
  amount              Int       @default(0)
  bank                String?   @db.VarChar(100)
  transfer_date       String?   @db.VarChar(50)
  transfer_time       String?   @db.VarChar(50)
  ref_no              String?   @db.VarChar(100)
  slip_url            String    @db.VarChar(500)
  status              String    @default("pending") @db.VarChar(20)
  rejection_reason    String?   @db.VarChar(500)
  resubmit_token      String?   @unique @db.VarChar(100)
  selected_activities Json?
  reviewed_by         String?   @db.VarChar(100)
  reviewed_at         DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @updatedAt @db.Timestamptz(6)

  members             Member?   @relation(fields: [member_no], references: [member_no], onDelete: Cascade, onUpdate: NoAction)
  meetings            meetings  @relation(fields: [meeting_id], references: [meeting_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([meeting_id], map: "idx_slips_meeting")
  @@index([member_no], map: "idx_slips_member")
  @@index([status], map: "idx_slips_status")
  @@index([resubmit_token], map: "idx_slips_resubmit_token")
}

model system_settings {
  key         String   @id @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model receipts {
  id                      String   @id @default(uuid()) @db.VarChar(50)
  receipt_no              String   @unique @db.VarChar(50)
  receipt_date            String   @db.VarChar(50)
  purpose_text            String   @db.VarChar(500)
  payer_type              String   @default("individual") @db.VarChar(20)
  payer_name              String   @db.VarChar(255)
  branch_name             String?  @db.VarChar(255)
  payer_address_line1     String?  @db.VarChar(500)
  payer_address_line2     String?  @db.VarChar(500)
  payer_phone             String?  @db.VarChar(50)
  payer_tax_id            String?  @db.VarChar(50)
  items                   Json
  total_amount            Int      @default(0)
  thai_baht_text_override String?  @db.VarChar(255)
  payer_signer_name       String?  @db.VarChar(255)
  payer_signer_role       String?  @default("ผู้จ่ายเงิน") @db.VarChar(100)
  payer_signed_date       String?  @db.VarChar(50)
  authorized_signer_name  String   @db.VarChar(255)
  authorized_signer_role  String?  @db.VarChar(100)
  authorized_signed_date  String?  @db.VarChar(50)
  prepared_by_name        String   @db.VarChar(255)
  prepared_by_role        String?  @default("ผู้จัดทำ") @db.VarChar(100)
  prepared_by_signed_date String?  @db.VarChar(50)
  association_name_th     String?  @db.VarChar(255)
  association_name_en     String?  @db.VarChar(255)
  association_address     String?  @db.VarChar(500)
  association_contact     String?  @db.VarChar(500)
  association_tax_id      String?  @db.VarChar(50)
  meeting_id              String?  @db.VarChar(50)
  attendee_id             String?  @db.VarChar(50)
  slip_id                 String?  @db.VarChar(50)
  status                  String   @default("issued") @db.VarChar(20)
  created_at              DateTime @default(now()) @db.Timestamptz(6)
  updated_at              DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([receipt_no], map: "idx_receipts_no")
  @@index([meeting_id], map: "idx_receipts_meeting")
  @@index([slip_id], map: "idx_receipts_slip")
  @@index([payer_name], map: "idx_receipts_payer")
}

model coupons {
  id               String          @id @default(uuid()) @db.VarChar(50)
  code             String          @unique @db.VarChar(50)
  company_name     String          @db.VarChar(255)
  meeting_id       String          @db.VarChar(50)
  discount_type    String          @default("free") @db.VarChar(20)
  discount_value   Int             @default(0)
  applicable_type  String          @default("all") @db.VarChar(20)
  max_uses         Int             @default(1)
  used_count       Int             @default(0)
  expire_date      DateTime?       @db.Date
  is_active        Boolean         @default(true)
  remarks          String?         @db.VarChar(500)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @default(now()) @updatedAt @db.Timestamptz(6)

  usages           coupon_usages[]
  meetings         meetings        @relation(fields: [meeting_id], references: [meeting_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([code], map: "idx_coupons_code")
  @@index([meeting_id], map: "idx_coupons_meeting")
}

model coupon_usages {
  id               BigInt          @id @default(autoincrement())
  coupon_id        String          @db.VarChar(50)
  meeting_id       String          @db.VarChar(50)
  member_no        String?         @db.VarChar(20)
  attendee_name    String          @db.VarChar(255)
  attendee_email   String          @db.VarChar(255)
  attendee_phone   String?         @db.VarChar(50)
  workplace        String?         @db.VarChar(255)
  discount_applied Int             @default(0)
  final_amount     Int             @default(0)
  ticket_code      String?         @db.VarChar(50)
  slip_id          String?         @db.VarChar(50)
  used_at          DateTime        @default(now()) @db.Timestamptz(6)

  coupon           coupons         @relation(fields: [coupon_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  meeting          meetings        @relation(fields: [meeting_id], references: [meeting_id], onDelete: Cascade, onUpdate: NoAction)
  member           Member?         @relation(fields: [member_no], references: [member_no], onDelete: SetNull, onUpdate: NoAction)

  @@index([coupon_id], map: "idx_coupon_usages_coupon")
  @@index([attendee_email], map: "idx_coupon_usages_email")
  @@index([meeting_id], map: "idx_coupon_usages_meeting")
  @@index([member_no], map: "idx_coupon_usages_member")
}


