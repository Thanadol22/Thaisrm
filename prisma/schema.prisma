generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id                   BigInt                @default(autoincrement())
  member_no            String                @id @unique @default(dbgenerated("lpad((nextval('member_no_seq'::regclass))::text, 4, '0'::text)")) @db.VarChar(20)
  fullNameTh           String                @map("full_name_th") @db.VarChar(255)
  fullNameEn           String?               @map("full_name_en") @db.VarChar(255)
  idLast4              String?               @map("id_last4") @db.VarChar(4)
  mobile               String?               @db.VarChar(30)
  email                String?               @unique @db.VarChar(255)
  lineId               String?               @map("line_id") @db.VarChar(100)
  address              String?
  workplace            String?               @db.VarChar(255)
  work_phone           String?               @db.VarChar(50)
  work_start_date      DateTime?             @db.Date
  position             String?               @db.VarChar(150)
  job_category         String?               @db.VarChar(50)
  job_category_other   String?               @db.VarChar(255)
  scientist_license_no String?               @db.VarChar(50)
  username             String?               @db.VarChar(100)
  password_hash        String?               @db.VarChar(255)
  referees             String?
  photo_url            String?               @db.VarChar(500)
  id_card_doc          String?               @db.VarChar(500)
  degree_cert_doc      String?               @db.VarChar(500)
  work_cert_doc        String?               @db.VarChar(500)
  membership_status    String?               @default("Active") @db.VarChar(50)
  membership_type      String?               @default("Regular") @db.VarChar(50)
  applied_at           DateTime?             @default(now()) @db.Timestamptz(6)
  expire_date          DateTime?             @db.Date
  special_expire_date  DateTime?             @db.Date
  qr_code_data         Json?
  qr_code_image_url    String?               @db.VarChar(500)
  meeting_attendances  meeting_attendances[]
  member_educations    member_educations[]

  @@index([email], map: "idx_members_email")
  @@index([fullNameTh], map: "idx_members_name_th")
  @@map("members")
}

model meeting_attendances {
  attendance_id     BigInt    @id @default(autoincrement())
  meeting_id        String    @db.VarChar(50)
  member_no         String    @db.VarChar(20)
  attendance_status String    @default("Attended") @db.VarChar(20)
  checkin_time      DateTime? @db.Timestamptz(6)
  meetings          meetings  @relation(fields: [meeting_id], references: [meeting_id], onUpdate: NoAction)
  members           Member    @relation(fields: [member_no], references: [member_no], onDelete: Cascade, onUpdate: NoAction)

  @@unique([meeting_id, member_no], map: "uq_member_meeting")
  @@index([meeting_id], map: "idx_attendance_meeting")
  @@index([member_no], map: "idx_attendance_member")
}

model meetings {
  meeting_id           String                @id @db.VarChar(50)
  meeting_name         String                @db.VarChar(255)
  meeting_date         DateTime              @db.Date
  counts_toward_active Boolean               @default(true)
  meeting_attendances  meeting_attendances[]
}

model member_educations {
  edu_id          BigInt  @id @default(autoincrement())
  member_no       String  @db.VarChar(20)
  degree          String  @db.VarChar(150)
  institution     String  @db.VarChar(255)
  graduation_year String? @db.VarChar(10)
  members         Member  @relation(fields: [member_no], references: [member_no], onDelete: Cascade, onUpdate: NoAction)
}
