# NextAuth.js
AUTH_SECRET=your_auth_secret_here
AUTH_URL=http://localhost:3000

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Admin Portal Authentication
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your_password_here  ← ใช้ได้เฉพาะ development เท่านั้น
# สร้าง ADMIN_PASSWORD_HASH ด้วย: node scripts/gen-admin-hash.mjs <password>
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/thaisrm?schema=public"

# Vercel Blob Storage
BLOB_STORE_ID=store_xxxxxx
BLOB_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxx
